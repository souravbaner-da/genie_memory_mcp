# Copy to .env for local development.

# --- Local Postgres (pgvector) via docker-compose ---
# When DATABASE_URL is set, Lakebase credential generation is skipped entirely.
DATABASE_URL=postgresql://memory:memory@localhost:5432/memory

# --- Embeddings (optional locally) ---
# Without Databricks creds the server runs keyword-only. To enable semantic
# search locally, set these and leave DATABASE_URL pointing at local Postgres.
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...
EMBED_ENDPOINT=databricks-gte-large-en
EMBED_DIM=1024

# --- Lakebase (production; leave unset for local dev) ---
# LAKEBASE_INSTANCE_NAME=genie-memory
# PGHOST=your-instance.database.cloud.databricks.com
# PGDATABASE=databricks_postgres
# PGUSER=your-app-service-principal-id
# PGPORT=5432
# PGSSLMODE=require
    